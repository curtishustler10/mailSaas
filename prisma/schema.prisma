generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  accounts      Account[]
  sessions      Session[]
  shops         Shop[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shop {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  shopifyDomain   String   @unique
  shopifyToken    String
  createdAt       DateTime @default(now())
  blocks          Block[]
}

model Block {
  id           String        @id @default(cuid())
  shop         Shop          @relation(fields: [shopId], references: [id])
  shopId       String
  name         String
  type         BlockType
  configJson   Json          // display + logic config
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  renderEvents RenderEvent[]
}

model RenderEvent {
  id        String   @id @default(cuid())
  block     Block    @relation(fields: [blockId], references: [id])
  blockId   String
  userId    String?  // external end-customer ID if available
  userAgent String?
  ipHash    String?  // if you want, hashed for privacy
  createdAt DateTime @default(now())

  @@index([blockId])
  @@index([createdAt])
  @@index([blockId, createdAt])
}

enum BlockType {
  HERO
  COUNTDOWN
  STOCK
  RECOMMENDATION
}
